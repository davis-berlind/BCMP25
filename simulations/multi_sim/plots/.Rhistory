lab <- c("BRCA Mutation", "ER Expression", "Tumor Grade", "Angioinvasion", "Lymphocytic\nInfiltrate")
for (i in 1:d) {
par(mar = c(0.2,5,0.1,0.1))
plot(Y[,i], pch=16, ylab = lab[i], xaxt = "n", cex.lab = 0.8)
lines(fit$mu_bar[,i])
}
layout(mat=matrix(1:(d+1),ncol = 1), heights = c(3,rep(1,d)))
par(mar = c(0.2,5,1,0.1))
plot(tree, type = "phylogram", show.tip.label = F , use.edge.length = F,
node.pos = 1, direction = "downwards", show.node.label = F, edge.width = lwdEdge,
main = "MICH Fit of All Genes")
lab <- c("BRCA Mutation", "ER Expression", "Tumor Grade", "Angioinvasion", "Lymphocytic\nInfiltrate")
for (i in 1:d) {
par(mar = c(0.2,5,0.1,0.1))
plot(Y[,i], pch=16, ylab = lab[i], xaxt = "n", cex.lab = 0.8)
#lines(fit$mu_bar[,i])
}
fit <- mult_mich_tree(Y, tree$edge,
L=4, L_auto=FALSE,
fit_intercept=TRUE, fit_scale=TRUE, standardize=FALSE,
tol=1e-5, max_iter=1000, verbose=TRUE,
restart=FALSE, increment=1,
merge_level=0.95, merge_prob=NULL,
pi_l=NULL, omega_l=1e-3
)
max(fit$elbo)
ci = mich::mich_sets(fit$pi_bar, level = 0.9)
est_cp <- ci$cp
layout(mat=matrix(1:(d+1),ncol = 1), heights = c(3,rep(1,d)))
par(mar = c(0.2,5,1,0.1))
plot(tree, type = "phylogram", show.tip.label = F , use.edge.length = F,
node.pos = 1, direction = "downwards", show.node.label = F, edge.width = lwdEdge,
main = "MICH Fit of All Genes")
for (l in 1:length(ci$sets)) {
nodelabels("", ci$sets[[l]], pch = 16, col = 1 + l, frame = "none", cex = 2)
}
lab <- c("BRCA Mutation", "ER Expression", "Tumor Grade", "Angioinvasion", "Lymphocytic\nInfiltrate")
for (i in 1:d) {
par(mar = c(0.2,5,0.1,0.1))
plot(Y[,i], pch=16, ylab = lab[i], xaxt = "n", cex.lab = 0.8)
lines(fit$mu_bar[,i], col = "red")
}
